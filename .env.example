# Copy to .env (git-ignored) for local runs via bin/lb.sh or bin/lb.ps1.
# Never commit real credentials.

# Image built from docker/liquibase/Dockerfile (not a LIQUIBASE_* name: Liquibase rejects unknown LIQUIBASE_* vars)
LB_IMAGE=christopher-liquibase:local

# Point at ONE fixed replica (e.g. via `kubectl port-forward svc/<replica-0-service> 8123:8123`),
# never the load-balanced cluster service. The path segment is the `liquibase` database,
# which holds ONLY Liquibase's ledger (DATABASECHANGELOG*), separate from raw/analytics.
LIQUIBASE_COMMAND_URL=jdbc:clickhouse://host.docker.internal:8123/liquibase
LIQUIBASE_COMMAND_USERNAME=liquibase
LIQUIBASE_COMMAND_PASSWORD=<set-locally-never-commit>

# Liquibase contexts for this environment (test | prod)
LB_CONTEXTS=test

# Databases bin/export-baseline.ps1 exports (comma-separated). Leave empty for every
# non-system database. Each one gets its own folder under liquibase/.
LB_DATABASES=raw,analytics
