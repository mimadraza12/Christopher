# Copy to .env (git-ignored) for local runs via bin/lb.sh or bin/lb.ps1.
# Never commit real credentials.

# Image built from docker/liquibase/Dockerfile (not a LIQUIBASE_* name: Liquibase rejects unknown LIQUIBASE_* vars)
LB_IMAGE=christopher-liquibase:local

# Point at ONE fixed replica (e.g. via `kubectl port-forward svc/<replica-0-service> 8123:8123`),
# never the load-balanced cluster service. The path segment is the default database,
# which is where DATABASECHANGELOG lives.
LIQUIBASE_COMMAND_URL=jdbc:clickhouse://localhost:8123/test_db
LIQUIBASE_COMMAND_USERNAME=liquibase
LIQUIBASE_COMMAND_PASSWORD=<set-locally-never-commit>

# Changelog parameter ${DB} used in every changeset
CH_DB=test_db
# Liquibase contexts for this environment (test | prod)
LB_CONTEXTS=test
